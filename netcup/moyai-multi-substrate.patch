+    def known_sandbox_provider(self):
+        if self.sandbox_provider not in self.sandbox_provider_names():
+            raise ValueError('Choose modal, substrate, or a cluster named in SUBSTRATE_CLUSTERS.')
+        for name in self.cluster_specs():
