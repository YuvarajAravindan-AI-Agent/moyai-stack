+    def cluster_specs(self) -> dict:
+        import json
+        specs = json.loads(self.substrate_clusters) if self.substrate_clusters.strip() else {}
+        if not isinstance(specs, dict) or any(not re.fullmatch(r'[a-z0-9]{1,20}', name) or not isinstance(spec, dict)
+                                              or set(spec) - CLUSTER_KEYS for name, spec in specs.items()):
+            raise ValueError('SUBSTRATE_CLUSTERS maps short lowercase names to cluster connection objects.')
+        return specs
+
+    def sandbox_provider_names(self) -> list[str]:
+        return ['modal', 'substrate'] + ['substrate-' + name for name in self.cluster_specs()]
+
+    def substrate_cluster(self, provider: str):
+        """Settings for one Substrate cluster: the primary one, or an extra SUBSTRATE_CLUSTERS entry."""
+        if provider == 'substrate':
+            return self
+        spec = self.cluster_specs().get(provider.removeprefix('substrate-')) if provider.startswith('substrate-') else None
+        if spec is None:
+            raise ValueError('Unknown Substrate cluster')
+        values = {**self.model_dump(), **{'substrate_' + key: value for key, value in spec.items()},
+                  'sandbox_provider': 'substrate', 'substrate_clusters': ''}
+        if spec.get('api_token'):
+            values['substrate_token_file'] = spec.get('token_file', '')
+        elif spec.get('token_file'):
+            values['substrate_api_token'] = ''
+        return type(self)(_env_file=None, **values)
+
