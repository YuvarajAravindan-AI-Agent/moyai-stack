+def eks_settings(tmp_path, **extra):
+    _, signing = key()
+    clusters = json.dumps({'eks': {'api_url': 'https://eks-api.example.com', 'router_url': 'https://eks-router.example.com',
+                                   'token_file': '/run/eks-token', 'atespace': 'moyai-aws', 'egress_hosts': 'github.com'}})
+    return Settings(_env_file=None, data_dir=tmp_path, substrate_api_url='https://api.example.com',
+                    substrate_router_url='https://router.example.com', substrate_api_token='gke-token',
+                    substrate_signing_key=signing, substrate_clusters=clusters, **extra)
+
+
+def test_extra_substrate_cluster_inherits_primary_and_overrides_its_endpoints(tmp_path):
+    from app.sandboxes import provider, provider_for_id
+    settings = eks_settings(tmp_path, sandbox_provider='substrate-eks')
+    assert settings.sandbox_provider_names() == ['modal', 'substrate', 'substrate-eks']
+    assert settings.missing_sandbox() == []
+    eks = provider(settings, 'substrate-eks')
+    assert eks.name == 'substrate-eks'
+    assert (eks.settings.substrate_api_url, eks.settings.substrate_atespace) == ('https://eks-api.example.com', 'moyai-aws')
+    assert (eks.settings.substrate_api_token, eks.settings.substrate_token_file) == ('', '/run/eks-token')
+    assert eks.settings.substrate_signing_key == settings.substrate_signing_key
+    assert eks.settings.substrate_template == 'moyai'
+    assert provider(settings, 'substrate').settings.substrate_api_url == 'https://api.example.com'
+    assert provider_for_id('substrate-eks:moyai-aws:one:uid') == 'substrate-eks'
+    assert provider_for_id('substrate:moyai:one:uid') == 'substrate'
+    assert provider_for_id('sb-modal123') == 'modal'
+
+
+@pytest.mark.parametrize('clusters', ['[]', '{"EKS": {}}', '{"eks": {"region": "us-east-1"}}', '{"eks": {"api_url": "http://x.example.com"}}'])
+def test_invalid_extra_clusters_are_rejected(tmp_path, clusters):
+    with pytest.raises(ValueError):
+        Settings(_env_file=None, data_dir=tmp_path, substrate_clusters=clusters)
+
+
