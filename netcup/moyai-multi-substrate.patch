+async def test_sandbox_and_snapshot_ids_carry_their_cluster(tmp_path):
+    from app.sandboxes import provider
+    settings = eks_settings(tmp_path)
+    eks, gke = provider(settings, 'substrate-eks'), provider(settings, 'substrate')
+    actor = pb.Actor(metadata={'atespace': 'moyai-aws', 'name': 'one', 'uid': 'actor-one'}, actor_template={'name': 'moyai'})
+    sandbox = Sandbox(eks, actor)
+    assert sandbox.object_id == 'substrate-eks:moyai-aws:one:actor-one'
+    with pytest.raises(ValueError, match='another Substrate cluster'):
+        await gke.get(sandbox.object_id)
+    eks.rpc = AsyncMock(return_value=actor)
+    assert (await eks.get(sandbox.object_id)).object_id == sandbox.object_id
+    sandbox._request = AsyncMock()
+    eks.rpc.reset_mock()
+    snapshot = await sandbox.snapshot_filesystem.aio()
+    assert snapshot.object_id.startswith('substrate-eks:moyai-aws:moyai:moyai-')
+    with pytest.raises(ValueError, match='another sandbox provider'):
+        await gke.create(snapshot_id=snapshot.object_id)
+
+
+def test_sessions_stay_on_their_cluster_after_default_switch(tmp_path):
+    settings = eks_settings(tmp_path, sandbox_provider='substrate')
+    store = Store(tmp_path)
+    manager = RunManager(store, settings)
+    old = store.create_run('On GKE', '', 'modal', [])
+    settings.sandbox_provider = 'substrate-eks'
+    new = store.create_run('On EKS', '', 'modal', [])
+    assert manager.provider(old).name == 'substrate'
+    assert manager.provider(new).name == 'substrate-eks'
+    assert manager.provider(identity='substrate-eks:moyai-aws:one:uid').settings.substrate_atespace == 'moyai-aws'
